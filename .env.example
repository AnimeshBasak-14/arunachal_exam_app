# Supabase Configuration
SUPABASE_DB_PASS=your_supabase_db_password
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Gemini AI Ingestion API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Supabase service_role key for admin scripts (never ship in the app)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Admin login for scripts when no service key is set
SUPABASE_ADMIN_EMAIL=your_admin_email
SUPABASE_ADMIN_PASSWORD=your_admin_password
