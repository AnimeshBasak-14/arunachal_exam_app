rules_version = '2';

// Profiles are stored at users/{lowercase email}. Only the signed-in owner
// can read or change their profile and test history. Deploy with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(email) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'dob', 'city', 'rating', 'profilePic', 'lastActive'])
        && d.name is string && d.name.size() <= 80
        && (!('profilePic' in d) || (d.profilePic is string && d.profilePic.size() <= 200000))
        && (!('rating' in d) || (d.rating is int && d.rating >= 0 && d.rating <= 1000000));
    }

    match /users/{email} {
      allow read, delete: if isOwner(email);
      allow create, update: if isOwner(email) && validProfile();

      match /quiz_history/{entry} {
        allow read, delete: if isOwner(email);
        allow create: if isOwner(email) && request.resource.data.size() < 60;
        allow update: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
